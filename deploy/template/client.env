# ---------------------------------------------------------------------------
# Honeypot instance settings for client: __CLIENT__
# Edit this file, then run: ./deploy.sh up __CLIENT__
# ---------------------------------------------------------------------------

HP_CLIENT=__CLIENT__
# Domain whose A record points at this honeypot (used for TLS + event tagging).
HP_DOMAIN=__DOMAIN__
# Hostname shown in SSH/Telnet prompts and banners. Pick something plausible
# for the client (e.g. web01, vpn-gw, erp-prod).
HP_HOSTNAME=__HOSTNAME__

# Host IP to publish ports on. Use a dedicated public IP per client when several
# clients share one host; 0.0.0.0 publishes on every interface.
HP_BIND_IP=0.0.0.0

# Services to expose: file names (without .yaml) from configurations/services/.
# Available: ssh-22 ssh-2222 telnet-23 http-80 http-8080 http-8081 http-maze-8888
#   tcp-3306 tcp-5432-postgresql-llm tcp-6379-redis tcp-1433-mssql tcp-3389-rdp
#   tcp-445-smb tcp-389-ldap tcp-1883-mqtt tcp-5900-vnc tcp-11211-memcached
#   http-11434-ollama mcp-8000
# "https-443" is synthesized from http-80 using the TLS certificate below.
HP_SERVICES="ssh-22 telnet-23 http-80 https-443 tcp-3306 tcp-6379-redis tcp-3389-rdp tcp-445-smb"

# TLS for https-443: selfsigned | letsencrypt (run ./deploy.sh cert __CLIENT__)
HP_TLS=selfsigned
HP_LETSENCRYPT_EMAIL=

# Prometheus metrics, published on the host loopback only. Unique per client.
HP_METRICS_PORT=__METRICS_PORT__

# Container resources.
HP_CONTAINER_MEM=384m
HP_MEM_LIMIT_MIB=200
HP_CPUS=1.0

# Event log rotation (inside the logrotate sidecar).
HP_LOG_MAX_MB=100
HP_LOG_KEEP_DAYS=30

# Optional central log shipping (enables the Vector sidecar when set).
# Example: HP_SHIP_URL=https://collector.example.net/honeypot
#          HP_SHIP_AUTH_HEADER="Bearer xxxxx"
HP_SHIP_URL=
HP_SHIP_AUTH_HEADER=

# Optional RabbitMQ event stream.
HP_RABBITMQ_ENABLED=false
HP_RABBITMQ_URI=

# Optional LLM-backed interactive shells (services using the LLMHoneypot plugin).
OPEN_AI_SECRET_KEY=
